{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "dynamodb:PutItem",
                "dynamodb:GetItem",
                "dynamodb:Scan",
                "dynamodb:Query",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:TransactWriteItems"
            ],
            "Resource": [
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Users",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Users/index/role-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Users/index/email-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Patients",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Patients/index/email-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Doctors",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Doctors/index/specialization-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Doctors/index/status-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Doctors/index/email-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-DoctorAvailability",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Appointments",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Appointments/index/doctor-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Appointments/index/patient-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Appointments/index/status-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Prescriptions",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Prescriptions/index/doctor-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Prescriptions/index/patient-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Prescriptions/index/appointment-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-DiagnosisReports",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-DiagnosisReports/index/patient-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-DiagnosisReports/index/appointment-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-MedicalDocuments",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-MedicalDocuments/index/patient-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Vitals",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Invoices",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Invoices/index/patient-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Invoices/index/status-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Reviews",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Reviews/index/doctor-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Reviews/index/patient-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Notifications",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Notifications/index/user-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-SupportTickets",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-SupportTickets/index/user-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-SupportTickets/index/status-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-AuditLogs",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-AuditLogs/index/user-index",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-LoginHistory",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-Specializations",
                "arn:aws:dynamodb:us-east-1:111122223333:table/MedTrack-SiteContent"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Resource": [
                "arn:aws:s3:::medtrack-documents-111122223333/uploads/*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "sns:Publish"
            ],
            "Resource": [
                "arn:aws:sns:us-east-1:111122223333:MedTrack-Alerts"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter",
                "ssm:GetParametersByPath"
            ],
            "Resource": [
                "arn:aws:ssm:us-east-1:111122223333:parameter/medtrack/prod/SECRET_KEY"
            ]
        }
    ]
}